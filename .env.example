# Environment: development | test | production
APP_ENV=development
APP_NAME=Industrial Predictive Maintenance Intelligence
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# API security. Leave blank only for local development; production refuses blank keys.
API_KEY=
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Database. SQLite is supported for a lightweight local demo and tests.
DATABASE_URL=sqlite:///./industrial_pm.db
# Compose production-style option:
# DATABASE_URL=postgresql+psycopg://industrial_pm:change-me@postgres:5432/industrial_pm
POSTGRES_DB=industrial_pm
POSTGRES_USER=industrial_pm
POSTGRES_PASSWORD=change-me

# Generated experiment and model artifacts
DATA_ROOT=./data
ARTIFACT_ROOT=./artifacts
MODEL_REGISTRY_ROOT=./model_registry
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=cmapss-fd001
MODEL_STAGE=champion

# Reproducibility / bounded CPU training
RANDOM_SEED=42
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCH_NUM_THREADS=4

# UI
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_DEMO_FALLBACK=false
VITE_STATIC_DEMO=false
VITE_BASE_PATH=/
